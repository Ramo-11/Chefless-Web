<% var pageTitle = 'Revenue'; %>
<% var page = 'revenue'; %>

<%
  // ── Server-side formatting helpers ─────────────────────────────
  // All money values arrive as unrounded USD numbers; format them here.
  function fmtUsd(n) {
    var v = Number(n || 0);
    var sign = v < 0 ? '-' : '';
    return sign + '$' + Math.abs(v).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }
  function fmtNum(n) {
    return Number(n || 0).toLocaleString('en-US');
  }
  function prettify(s) {
    if (!s) return '';
    return String(s)
      .replace(/_/g, ' ')
      .toLowerCase()
      .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
  }
  // Friendly store names with a graceful fallback to the raw value.
  function storeLabel(s) {
    var map = {
      APP_STORE: 'Apple App Store',
      app_store: 'Apple App Store',
      MAC_APP_STORE: 'Mac App Store',
      PLAY_STORE: 'Google Play',
      play_store: 'Google Play',
      STRIPE: 'Stripe',
      stripe: 'Stripe',
      AMAZON: 'Amazon Appstore',
      amazon: 'Amazon Appstore',
      PROMOTIONAL: 'Promotional',
      promotional: 'Promotional',
    };
    return map[s] || prettify(s);
  }
  function fmtDate(d) {
    if (!d) return '';
    return new Date(d).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  }

  var isEmpty = (totals.transactionCount === 0 && totals.refundCount === 0);
%>

<div class="page-header revenue-header">
  <div>
    <h1>Revenue</h1>
    <p class="page-subtitle">Subscription revenue, store cuts, and payouts</p>
  </div>
  <% if (dataSince) { %>
    <span class="revenue-since">Data since <%= fmtDate(dataSince) %></span>
  <% } %>
</div>

<% if (sandboxCount > 0) { %>
  <p class="revenue-sandbox-note">
    <%= fmtNum(sandboxCount) %> sandbox transaction<%= sandboxCount === 1 ? '' : 's' %> excluded from these figures.
  </p>
<% } %>

<!-- KPI Stats: Row 1 (net, proceeds, MRR, ARR) + Row 2 (gross, store cut, subscribers, ARPU) -->
<div class="stats-grid">
  <div class="stat-card stat-accent-green">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(totals.netRevenue) %></span>
      <span class="stat-label">Net Revenue</span>
    </div>
    <div class="stat-trend">All time, after refunds</div>
  </div>

  <div class="stat-card stat-accent-blue">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(totals.estimatedProceeds) %></span>
      <span class="stat-label">Estimated Proceeds</span>
    </div>
    <div class="stat-trend">After store cuts</div>
  </div>

  <div class="stat-card stat-accent-purple">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(recurring.mrr) %></span>
      <span class="stat-label">MRR</span>
    </div>
    <div class="stat-trend"><%= fmtNum(recurring.payingSubscribers) %> paying</div>
  </div>

  <div class="stat-card stat-accent-purple">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(recurring.arr) %></span>
      <span class="stat-label">ARR</span>
    </div>
    <div class="stat-trend">Annualized run rate</div>
  </div>

  <div class="stat-card stat-accent-slate">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(totals.grossRevenue) %></span>
      <span class="stat-label">Gross Revenue</span>
    </div>
    <div class="stat-trend"><%= fmtNum(totals.transactionCount) %> transactions</div>
  </div>

  <div class="stat-card stat-accent-amber">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(totals.storeCut) %></span>
      <span class="stat-label">Store Cut</span>
    </div>
    <div class="stat-trend">Apple and Google fees</div>
  </div>

  <div class="stat-card stat-accent-blue">
    <div class="stat-content">
      <span class="stat-value"><%= fmtNum(recurring.payingSubscribers) %></span>
      <span class="stat-label">Paying Subscribers</span>
    </div>
    <div class="stat-trend">
      <%= fmtNum(recurring.monthlySubscribers) %> monthly, <%= fmtNum(recurring.annualSubscribers) %> annual
    </div>
  </div>

  <div class="stat-card stat-accent-green">
    <div class="stat-content">
      <span class="stat-value"><%= fmtUsd(recurring.arpu) %></span>
      <span class="stat-label">ARPU</span>
    </div>
    <div class="stat-trend">Avg revenue per paying user</div>
  </div>
</div>

<% if (isEmpty) { %>

<!-- Empty state: no transactions recorded yet -->
<div class="card">
  <div class="empty-state revenue-empty">
    <p><strong>No transactions recorded yet</strong></p>
    <p>Revenue data flows in automatically from the RevenueCat webhook as customers subscribe, renew, or refund. Once the first purchase lands, this dashboard fills in with gross revenue, store cuts, payouts, and subscriber trends.</p>
  </div>
</div>

<% } else { %>

<!-- Monthly revenue trend -->
<div class="chart-card revenue-chart-full">
  <div class="chart-card-header">
    <h3>Monthly Revenue Trend</h3>
    <span class="chart-card-subtitle">Gross revenue and estimated proceeds, last 12 months</span>
  </div>
  <div class="chart-container chart-container-tall">
    <canvas id="monthlyRevenueChart"></canvas>
  </div>
</div>

<!-- Store gross split + Subscribers panel -->
<div class="revenue-grid-2">
  <div class="chart-card">
    <div class="chart-card-header">
      <h3>Gross Revenue by Store</h3>
      <span class="chart-card-subtitle">Where the money comes in</span>
    </div>
    <div class="chart-container chart-container-doughnut">
      <canvas id="storeGrossChart"></canvas>
    </div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <h3>Subscribers</h3>
      <span class="chart-card-subtitle">Active paying members and grants</span>
    </div>
    <div class="revenue-facts">
      <div class="revenue-fact">
        <span class="revenue-fact-label">Monthly subscribers</span>
        <span class="revenue-fact-value"><%= fmtNum(recurring.monthlySubscribers) %></span>
      </div>
      <div class="revenue-fact">
        <span class="revenue-fact-label">Annual subscribers</span>
        <span class="revenue-fact-value"><%= fmtNum(recurring.annualSubscribers) %></span>
      </div>
      <div class="revenue-fact">
        <span class="revenue-fact-label">Complimentary grants</span>
        <span class="revenue-fact-value"><%= fmtNum(recurring.adminGrants) %></span>
      </div>
      <div class="revenue-fact">
        <span class="revenue-fact-label">Refunds</span>
        <span class="revenue-fact-value"><%= fmtNum(totals.refundCount) %></span>
      </div>
      <div class="revenue-fact">
        <span class="revenue-fact-label">Refunded amount</span>
        <span class="revenue-fact-value text-error"><%= fmtUsd(totals.refunds) %></span>
      </div>
      <p class="revenue-fact-note">Complimentary admin grants are excluded from MRR and ARR.</p>
    </div>
  </div>
</div>

<!-- Store breakdown table -->
<div class="card">
  <div class="card-header">
    <h2>Store Breakdown</h2>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Store</th>
          <th class="num">Transactions</th>
          <th class="num">Gross Revenue</th>
          <th class="num">Store Cut</th>
          <th class="num">Proceeds</th>
        </tr>
      </thead>
      <tbody>
        <% byStore.forEach(function (s) { %>
        <tr>
          <td><strong><%= storeLabel(s.store) %></strong></td>
          <td class="num text-muted"><%= fmtNum(s.transactionCount) %></td>
          <td class="num"><%= fmtUsd(s.grossRevenue) %></td>
          <td class="num text-error"><%= fmtUsd(s.storeCut) %></td>
          <td class="num"><strong><%= fmtUsd(s.proceeds) %></strong></td>
        </tr>
        <% }); %>
        <% if (byStore.length === 0) { %>
        <tr><td colspan="5" class="empty-state">No store data yet</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Recent transactions -->
<div class="card">
  <div class="card-header">
    <h2>Recent Transactions</h2>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>User</th>
          <th>Type</th>
          <th>Store</th>
          <th>Product</th>
          <th class="num">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% recentTransactions.forEach(function (t) { %>
        <tr>
          <td class="text-muted"><%= fmtDate(t.date) %></td>
          <td>
            <% if (t.userName) { %>
              <div class="tx-user">
                <span class="tx-user-name"><%= t.userName %></span>
                <% if (t.userEmail) { %><span class="tx-user-email"><%= t.userEmail %></span><% } %>
              </div>
            <% } else if (t.userEmail) { %>
              <span class="tx-user-name"><%= t.userEmail %></span>
            <% } else { %>
              <span class="text-muted">Unknown user</span>
            <% } %>
          </td>
          <td><span class="badge badge-default"><%= prettify(t.type) %></span></td>
          <td class="text-muted"><%= storeLabel(t.store) %></td>
          <td class="text-muted"><%= t.productId %></td>
          <td class="num <%= t.priceUsd < 0 ? 'tx-amount-negative' : '' %>"><%= fmtUsd(t.priceUsd) %></td>
        </tr>
        <% }); %>
        <% if (recentTransactions.length === 0) { %>
        <tr><td colspan="6" class="empty-state">No transactions yet</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- AI cost (Claude) -->
<div class="card">
  <div class="card-header">
    <h2>AI Cost (Claude)</h2>
  </div>
  <div class="ai-cost-body">
    <div class="ai-cost-tiles">
      <div class="ai-cost-tile">
        <span class="ai-cost-value"><%= fmtUsd(aiCost.costThisMonth) %></span>
        <span class="ai-cost-label">This month</span>
        <span class="ai-cost-sub"><%= fmtNum(aiCost.callsThisMonth) %> calls</span>
      </div>
      <div class="ai-cost-tile">
        <span class="ai-cost-value"><%= fmtUsd(aiCost.costLastMonth) %></span>
        <span class="ai-cost-label">Last month</span>
      </div>
      <div class="ai-cost-tile">
        <span class="ai-cost-value"><%= fmtUsd(aiCost.costAllTime) %></span>
        <span class="ai-cost-label">All time</span>
        <span class="ai-cost-sub"><%= fmtNum(aiCost.callsAllTime) %> calls</span>
      </div>
      <div class="ai-cost-tile">
        <span class="ai-cost-value"><%= fmtNum(aiCost.tokensAllTime.input + aiCost.tokensAllTime.output) %></span>
        <span class="ai-cost-label">Tokens all time</span>
        <span class="ai-cost-sub"><%= fmtNum(aiCost.tokensAllTime.input) %> in / <%= fmtNum(aiCost.tokensAllTime.output) %> out</span>
      </div>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Feature</th>
            <th class="num">Calls</th>
            <th class="num">Cost</th>
          </tr>
        </thead>
        <tbody>
          <% aiCost.byFeature.forEach(function (f) { %>
          <tr>
            <td><strong><%= prettify(f.feature) %></strong></td>
            <td class="num text-muted"><%= fmtNum(f.calls) %></td>
            <td class="num"><%= fmtUsd(f.costUsd) %></td>
          </tr>
          <% }); %>
          <% if (aiCost.byFeature.length === 0) { %>
          <tr><td colspan="3" class="empty-state">No AI calls recorded yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (aiCost.trackingSince) { %>
    <p class="ai-cost-note">Token-level cost tracking started <%= fmtDate(aiCost.trackingSince) %>. Calls made before that date are not included here (see the AI usage card on Analytics for lifetime call counts).</p>
    <% } else { %>
    <p class="ai-cost-note">Cost tracking is live but no AI calls have been recorded yet. Lifetime call counts (without cost) are on the Analytics page.</p>
    <% } %>
  </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>
(function () {
  // ── Color palette ──
  var COLORS = {
    terracotta: '#C45C3A',
    gold: '#D4920B',
    green: '#10b981',
    blue: '#3b82f6',
    purple: '#8b5cf6',
    amber: '#f59e0b',
    pink: '#ec4899',
    teal: '#14b8a6',
    slate: '#64748b'
  };
  var PALETTE = [
    COLORS.slate, COLORS.green, COLORS.blue, COLORS.terracotta,
    COLORS.purple, COLORS.amber, COLORS.pink, COLORS.teal,
    '#6366f1', '#ef4444'
  ];

  // ── Chart defaults ──
  Chart.defaults.font.family = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.font.size = 12;
  Chart.defaults.color = '#64748b';
  Chart.defaults.plugins.legend.labels.usePointStyle = true;
  Chart.defaults.plugins.legend.labels.pointStyleWidth = 8;
  Chart.defaults.plugins.legend.labels.padding = 16;

  // ── Data from server ──
  var monthlyTrend = <%- JSON.stringify(monthlyTrend) %>;
  var byStore = <%- JSON.stringify(byStore) %>;

  // ── Currency formatters ──
  function usdAxis(v) {
    return '$' + Number(v || 0).toLocaleString('en-US', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    });
  }
  function usdFull(v) {
    return '$' + Number(v || 0).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }
  // Friendly store names, mirrors the server-side helper.
  function storeLabelJs(s) {
    var map = {
      APP_STORE: 'Apple App Store',
      app_store: 'Apple App Store',
      MAC_APP_STORE: 'Mac App Store',
      PLAY_STORE: 'Google Play',
      play_store: 'Google Play',
      STRIPE: 'Stripe',
      stripe: 'Stripe',
      AMAZON: 'Amazon Appstore',
      amazon: 'Amazon Appstore',
      PROMOTIONAL: 'Promotional',
      promotional: 'Promotional'
    };
    if (map[s]) return map[s];
    if (!s) return '';
    return String(s).replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, function (c) {
      return c.toUpperCase();
    });
  }

  // ── 1. Monthly Revenue Trend (Bar, two datasets) ──
  new Chart(document.getElementById('monthlyRevenueChart'), {
    type: 'bar',
    data: {
      labels: monthlyTrend.map(function (m) { return m.month; }),
      datasets: [
        {
          label: 'Gross Revenue',
          data: monthlyTrend.map(function (m) { return m.gross; }),
          backgroundColor: COLORS.terracotta,
          borderRadius: 4,
          borderSkipped: false,
          categoryPercentage: 0.7,
          barPercentage: 0.85
        },
        {
          label: 'Estimated Proceeds',
          data: monthlyTrend.map(function (m) { return m.proceeds; }),
          backgroundColor: COLORS.green,
          borderRadius: 4,
          borderSkipped: false,
          categoryPercentage: 0.7,
          barPercentage: 0.85
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'top' },
        tooltip: {
          callbacks: {
            label: function (ctx) {
              return ctx.dataset.label + ': ' + usdFull(ctx.parsed.y);
            }
          }
        }
      },
      scales: {
        x: { grid: { display: false } },
        y: {
          beginAtZero: true,
          ticks: { callback: function (v) { return usdAxis(v); } }
        }
      }
    }
  });

  // ── 2. Gross Revenue by Store (Doughnut) ──
  if (byStore.length > 0) {
    new Chart(document.getElementById('storeGrossChart'), {
      type: 'doughnut',
      data: {
        labels: byStore.map(function (s) { return storeLabelJs(s.store); }),
        datasets: [{
          data: byStore.map(function (s) { return s.grossRevenue; }),
          backgroundColor: PALETTE.slice(0, byStore.length),
          borderWidth: 0,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '60%',
        plugins: {
          legend: { position: 'right', labels: { boxWidth: 12 } },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ctx.label + ': ' + usdFull(ctx.parsed);
              }
            }
          }
        }
      }
    });
  } else {
    document.getElementById('storeGrossChart').parentElement.innerHTML =
      '<div class="chart-empty">No store data</div>';
  }
})();
</script>

<% } %>

<style>
/* ── Revenue-specific styles ───────────────────────────────── */

.revenue-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.revenue-since {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--surface);
  border: 1px solid var(--border-color);
  border-radius: 999px;
  padding: 0.4rem 0.85rem;
  font-size: 0.8rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.revenue-since i { font-size: 0.75rem; }

.revenue-sandbox-note {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-bottom: 1.25rem;
}

/* ── Chart cards (shared visual language with Analytics) ────── */
.chart-card {
  background: var(--surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.chart-card-header {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border-color);
}

.chart-card-header h3 {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.chart-card-header h3 i { color: var(--text-muted); }

.chart-card-subtitle {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-top: 0.15rem;
  display: block;
}

.chart-container {
  padding: 1.25rem;
  height: 260px;
  position: relative;
}

.chart-container-doughnut { height: 300px; }
.chart-container-tall { height: 320px; }

.chart-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--text-muted);
  font-size: 0.875rem;
}

.revenue-chart-full { margin-bottom: 1.5rem; }

.revenue-grid-2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

/* ── Subscribers fact list ─────────────────────────────────── */
.revenue-facts {
  padding: 0.75rem 1.25rem 1.25rem;
}

.revenue-fact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--border-color);
}

.revenue-fact-label {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.875rem;
  color: var(--text-secondary);
}

.revenue-fact-label i {
  color: var(--text-muted);
  width: 16px;
  text-align: center;
}

.revenue-fact-value {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-primary);
}

.revenue-fact-note {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 0.85rem;
  line-height: 1.5;
}

/* ── Numeric table columns ─────────────────────────────────── */
.data-table th.num,
.data-table td.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ── Transaction user + amount cells ───────────────────────── */
.tx-user {
  display: flex;
  flex-direction: column;
  line-height: 1.35;
}

.tx-user-name { font-weight: 500; }

.tx-user-email {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.tx-amount-negative {
  color: var(--danger);
  font-weight: 600;
}

/* ── Empty state ───────────────────────────────────────────── */
.revenue-empty p {
  max-width: 540px;
  margin: 0 auto 0.5rem;
  line-height: 1.6;
}

.revenue-empty p:last-child { margin-bottom: 0; }

/* ── AI cost card ──────────────────────────────────────────── */
.ai-cost-body { padding: 1.25rem 1.5rem 1.5rem; }

.ai-cost-tiles {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.ai-cost-tile {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--border-color);
  border-radius: 8px;
}

.ai-cost-value {
  font-size: 1.25rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.ai-cost-label {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.ai-cost-sub {
  font-size: 0.72rem;
  color: var(--text-muted);
}

.ai-cost-note {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 0.85rem;
  line-height: 1.5;
}

/* ── Responsive ────────────────────────────────────────────── */
@media (max-width: 960px) {
  .revenue-grid-2 { grid-template-columns: 1fr; }
  .ai-cost-tiles { grid-template-columns: repeat(2, 1fr); }
}
</style>
