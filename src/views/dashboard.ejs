<% var pageTitle = 'Dashboard'; %>
<% var page = 'dashboard'; %>

<div class="page-header">
  <h1>Dashboard</h1>
  <p class="page-subtitle">Overview of your Chefless platform</p>
</div>

<!-- Stats Grid -->
<div class="stats-grid">
  <div class="stat-card stat-accent-blue">
    <div class="stat-content">
      <span class="stat-value"><%= stats.totalUsers.toLocaleString() %></span>
      <span class="stat-label">Total Users</span>
    </div>
    <div class="stat-trend stat-trend-up">
      <%= stats.newUsersWeek %> this week
    </div>
  </div>

  <div class="stat-card stat-accent-green">
    <div class="stat-content">
      <span class="stat-value"><%= stats.totalRecipes.toLocaleString() %></span>
      <span class="stat-label">Recipes</span>
    </div>
  </div>

  <div class="stat-card stat-accent-purple">
    <div class="stat-content">
      <span class="stat-value"><%= stats.totalKitchens.toLocaleString() %></span>
      <span class="stat-label">Kitchens</span>
    </div>
  </div>

  <div class="stat-card stat-accent-amber">
    <div class="stat-content">
      <span class="stat-value"><%= stats.premiumUsers.toLocaleString() %></span>
      <span class="stat-label">Premium Users</span>
    </div>
  </div>

  <% if (revenue) { %>
  <div class="stat-card stat-accent-green">
    <div class="stat-content">
      <span class="stat-value"><%= revenue.netRevenue.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %></span>
      <span class="stat-label">Net Revenue</span>
    </div>
    <a href="/admin/revenue" class="stat-action stat-action-revenue">View revenue -&gt;</a>
  </div>

  <div class="stat-card stat-accent-purple">
    <div class="stat-content">
      <span class="stat-value"><%= revenue.mrr.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %></span>
      <span class="stat-label">MRR</span>
    </div>
    <div class="stat-trend"><%= revenue.payingSubscribers.toLocaleString() %> paying</div>
  </div>
  <% } %>

  <div class="stat-card stat-accent-red <%= stats.pendingReports > 0 ? 'stat-card-alert' : '' %>">
    <div class="stat-content">
      <span class="stat-value"><%= stats.pendingReports %></span>
      <span class="stat-label">Pending Reports</span>
    </div>
    <% if (stats.pendingReports > 0) { %>
      <a href="/admin/reports" class="stat-action">Review -&gt;</a>
    <% } %>
  </div>

  <div class="stat-card stat-accent-red <%= stats.openCrashes > 0 ? 'stat-card-alert' : '' %>">
    <div class="stat-content">
      <span class="stat-value"><%= stats.openCrashes %></span>
      <span class="stat-label">Open Crashes</span>
    </div>
    <% if (stats.crashesWeek > 0) { %>
      <div class="stat-trend"><%= stats.crashesWeek %> this week</div>
    <% } %>
    <% if (stats.openCrashes > 0) { %>
      <a href="/admin/errors" class="stat-action">Investigate -&gt;</a>
    <% } %>
  </div>

  <div class="stat-card stat-accent-slate">
    <div class="stat-content">
      <span class="stat-value"><%= stats.bannedUsers %></span>
      <span class="stat-label">Banned Users</span>
    </div>
  </div>
</div>

<!-- Recent Users -->
<div class="card">
  <div class="card-header">
    <h2>Recent Signups</h2>
    <a href="/admin/users" class="btn btn-sm btn-secondary">View All</a>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Email</th>
          <th>Status</th>
          <th>Joined</th>
        </tr>
      </thead>
      <tbody>
        <% recentUsers.forEach(function(user) { %>
        <tr>
          <td>
            <div class="user-cell">
              <% if (user.profilePicture) { %>
                <img src="<%= user.profilePicture %>" alt="" class="avatar-sm">
              <% } else { %>
                <div class="avatar-sm avatar-placeholder">
                  <%= user.fullName.charAt(0).toUpperCase() %>
                </div>
              <% } %>
              <span><%= user.fullName %></span>
            </div>
          </td>
          <td class="text-muted"><%= user.email %></td>
          <td>
            <% if (user.isPremium) { %>
              <span class="badge badge-premium">Premium</span>
            <% } else { %>
              <span class="badge badge-default">Free</span>
            <% } %>
          </td>
          <td class="text-muted"><%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
        </tr>
        <% }); %>
        <% if (recentUsers.length === 0) { %>
        <tr>
          <td colspan="4" class="empty-state">No users yet</td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<style>
/* The Net Revenue tile links to the revenue page; the shared .stat-action
   colour signals alerts (red), so recolour this variant to the brand hue. */
.stat-action-revenue { color: var(--primary); }
.stat-action-revenue:hover { text-decoration: underline; }
</style>

