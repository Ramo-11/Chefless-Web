<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>Chefless Admin</title>
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="/admin/images/logo.png" alt="Chefless" style="width:32px;height:32px;object-fit:contain;border-radius:8px;">
          <span>Chefless</span>
        </div>
        <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">Menu</button>
      </div>

      <nav class="sidebar-nav">
        <a href="/admin" class="nav-item <%= page === 'dashboard' ? 'active' : '' %>">
          <span>Dashboard</span>
        </a>
        <a href="/admin/analytics" class="nav-item <%= page === 'analytics' ? 'active' : '' %>">
          <span>Analytics</span>
        </a>
        <a href="/admin/revenue" class="nav-item <%= page === 'revenue' ? 'active' : '' %>">
          <span>Revenue</span>
        </a>
        <a href="/admin/users" class="nav-item <%= page === 'users' ? 'active' : '' %>">
          <span>Users</span>
        </a>
        <a href="/admin/recipes" class="nav-item <%= page === 'recipes' ? 'active' : '' %>">
          <span>Recipes</span>
        </a>
        <a href="/admin/moderated-posts" class="nav-item <%= page === 'moderated-posts' ? 'active' : '' %>">
          <span>Moderated Posts</span>
        </a>
        <a href="/admin/kitchens" class="nav-item <%= page === 'kitchens' ? 'active' : '' %>">
          <span>Kitchens</span>
        </a>
        <a href="/admin/reports" class="nav-item <%= page === 'reports' ? 'active' : '' %>">
          <span>Reports</span>
          <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
            <span class="badge badge-danger"><%= pendingCount %></span>
          <% } %>
        </a>
        <a href="/admin/feedback" class="nav-item <%= page === 'feedback' ? 'active' : '' %>">
          <span>Feedback</span>
        </a>
        <a href="/admin/early-access" class="nav-item <%= page === 'early-access' ? 'active' : '' %>">
          <span>Early Access</span>
        </a>
        <a href="/admin/errors" class="nav-item <%= page === 'errors' ? 'active' : '' %>">
          <span>Crashes</span>
          <% if (typeof openCrashesCount !== 'undefined' && openCrashesCount > 0) { %>
            <span class="badge badge-danger"><%= openCrashesCount %></span>
          <% } %>
        </a>
        <a href="/admin/labels" class="nav-item <%= page === 'labels' ? 'active' : '' %>">
          <span>Labels</span>
        </a>
        <a href="/admin/seasonal" class="nav-item <%= page === 'seasonal' ? 'active' : '' %>">
          <span>Seasonal</span>
        </a>
        <a href="/admin/app-config" class="nav-item <%= page === 'app-config' ? 'active' : '' %>">
          <span>App Settings</span>
        </a>
        <a href="/admin/seed-data" class="nav-item <%= page === 'seed-data' ? 'active' : '' %>">
          <span>Seed Data</span>
        </a>
        <% if (adminRole === 'super_admin') { %>
          <a href="/admin/admins" class="nav-item <%= page === 'admins' ? 'active' : '' %>">
            <span>Admins</span>
          </a>
        <% } %>
      </nav>

      <div class="sidebar-footer">
        <div class="admin-info">
          <div class="admin-avatar"><%= adminName.charAt(0).toUpperCase() %></div>
          <div class="admin-details">
            <span class="admin-name"><%= adminName %></span>
            <span class="admin-role"><%= adminRole === 'super_admin' ? 'Super Admin' : 'Admin' %></span>
          </div>
        </div>
        <form action="/admin/logout" method="POST" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-logout">Log out</button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <header class="top-bar">
        <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu">Menu</button>
        <div class="breadcrumb">
          <% if (page !== 'dashboard') { %>
            <a href="/admin">Dashboard</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <span><%= page.charAt(0).toUpperCase() + page.slice(1) %></span>
          <% } else { %>
            <span>Dashboard</span>
          <% } %>
        </div>
      </header>

      <div class="content-area">
        <%- body %>
      </div>
    </main>
  </div>

  <!-- Notification Toast -->
  <div class="toast" id="toast">
    <span class="toast-message"></span>
  </div>

  <!-- Overlay for mobile sidebar -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <script src="/admin/js/admin.js"></script>
</body>
</html>
